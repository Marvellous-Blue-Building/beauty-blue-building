PORT=3004

# Pick ONE auth mode — app/gemini.py tries Vertex AI first, then falls back
# to the Gemini Developer API.

# Vertex AI (used when deployed to Cloud Run): set your GCP project here and
# authenticate locally with `gcloud auth application-default login`. On
# Cloud Run this isn't needed — the service account's own identity is used,
# granted the roles/aiplatform.user IAM role instead.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1

# Gemini Developer API (simpler for local dev without a GCP project set up):
# get a free key at https://aistudio.google.com/apikey. Only read when
# GOOGLE_CLOUD_PROJECT above is unset.
GEMINI_API_KEY=

# Swap for a different Gemini model if you want; gemini-2.5-flash is the
# cheap/fast default.
GEMINI_MODEL=gemini-2.5-flash
