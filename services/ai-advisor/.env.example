PORT=3004

# Kaggle API credentials — needed to download Gemma weights via kagglehub.
# Create one at https://www.kaggle.com/settings -> API -> Create New Token,
# and accept the Gemma license at both:
#   https://www.kaggle.com/models/google/gemma/license/consent
#   https://www.kaggle.com/models/google/gemma-2/license/consent
#
# IMPORTANT: Kaggle's newer "KGAT_..." tokens only work for gated/consent
# -required downloads (like Gemma) when sent as an OAuth Bearer token, not
# HTTP Basic auth. kagglehub silently uses Basic auth (KAGGLE_USERNAME +
# KAGGLE_KEY) unless KAGGLE_API_TOKEN is also set, in which case it switches
# to Bearer auth. Basic auth still works for public metadata reads, which is
# why the failure mode is a confusing 403 "permission" error on file
# downloads specifically, not a 401 on everything.
KAGGLE_USERNAME=<your-kaggle-username>
KAGGLE_KEY=<your-kaggle-api-key>
KAGGLE_API_TOKEN=<same value as KAGGLE_KEY, e.g. KGAT_...>

# Kaggle model handle (framework=transformers so it loads with
# transformers.AutoModelForCausalLM). Swap for a larger variant if you have
# a GPU; the default 2B variant is the only one practical on CPU.
GEMMA_KAGGLE_HANDLE=google/gemma-2/transformers/gemma-2-2b-it
