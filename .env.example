# Used by docker-compose.yml (docker compose reads .env from this same
# directory automatically for ${VAR} substitution). Copy to .env and
# fill in real values before `docker compose up`.
#
# Inter-service URLs, DATABASE_URL and REDIS_URL are NOT listed here —
# docker-compose.yml sets those directly to the compose service DNS
# names (e.g. http://matching-service:8000), not via this file.

# apps/web — admin dashboard login (see apps/web/lib/auth/admin-session.ts)
ADMIN_PASSWORD=

# apps/web — Google OAuth2 login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# apps/web — embeddable widget config/CORS
ALLOWED_WIDGET_ORIGINS=
WIDGET_BOT_NAME=
WIDGET_GREETING=
WIDGET_COLOR=
WIDGET_POSITION=
WIDGET_PRIVACY_URL=
WIDGET_TERMS_URL=

# apps/web — outgoing alert/report emails (lib/email/smtp-client.ts)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# services/ai-advisor — Gemma model download via kagglehub
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_API_TOKEN=
GEMMA_KAGGLE_HANDLE=google/gemma-2/transformers/gemma-2-2b-it

# apps/web — baked in at build time, not runtime (see Dockerfile ARG)
NEXT_PUBLIC_API_BASE_URL=
