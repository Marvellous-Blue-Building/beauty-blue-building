# Used by docker-compose.yml (docker compose reads .env from this same
# directory automatically for ${VAR} substitution). Copy to .env and
# fill in real values before `docker compose up`.
#
# Inter-service URLs, DATABASE_URL and REDIS_URL are NOT listed here —
# docker-compose.yml sets those directly to the compose service DNS
# names (e.g. http://matching-service:8000), not via this file.

# apps/web — admin dashboard login (see apps/web/lib/auth/admin-session.ts)
ADMIN_PASSWORD=

# apps/web — Google OAuth2 login
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# apps/web — embeddable widget config/CORS
ALLOWED_WIDGET_ORIGINS=
WIDGET_BOT_NAME=
WIDGET_GREETING=
WIDGET_COLOR=
WIDGET_POSITION=
WIDGET_PRIVACY_URL=
WIDGET_TERMS_URL=

# apps/web — outgoing alert/report emails (lib/email/smtp-client.ts)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# services/ai-advisor — Gemini via google-genai. Set GOOGLE_CLOUD_PROJECT for
# Vertex AI (needs ADC creds mounted in to work from Compose; on Cloud Run
# itself the service account's own identity is used instead), or
# GEMINI_API_KEY (https://aistudio.google.com/apikey) as the simpler local
# alternative — read only when GOOGLE_CLOUD_PROJECT is unset.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# apps/web — baked in at build time, not runtime (see Dockerfile ARG)
NEXT_PUBLIC_API_BASE_URL=
